# Root environment variables — example / template
# This file is safe to commit. Copy to .env and fill in real values.
# The backend reads from backend/.env directly; this root file is provided
# for tooling (docker-compose, scripts) that sources from the repo root.

# ── Database ─────────────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agric_stat_db
# Leave unset to use SQLite. Set for PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/agric_stat_db

# ── Server ────────────────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DEBUG=False

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-output-of-secrets-token-hex-32

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed by the backend.
# Production: set to your deployed frontend URL, e.g. https://agric-stat.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Frontend ──────────────────────────────────────────────────────────────────
WEB_URL=http://localhost:3000
MOBILE_API_URL=http://192.168.1.100:8000

# ── Forecasting ───────────────────────────────────────────────────────────────
FORECAST_DAYS=30
FORECAST_MODEL=prophet

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
