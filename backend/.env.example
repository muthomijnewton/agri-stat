# Backend environment variables — example / template
# Copy this file to backend/.env and fill in real values before running.

# ── Database ────────────────────────────────────────────────────────────────
# Leave DATABASE_URL unset to use SQLite (backend/agric_stat.db).
# Set it for PostgreSQL: postgresql://user:password@host:5432/dbname
# DATABASE_URL=postgresql://postgres:password@localhost:5432/agric_stat_db

# ── Server ───────────────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DEBUG=False

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The application will refuse to start if this is missing or set to a placeholder.
SECRET_KEY=replace-with-output-of-secrets-token-hex-32

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call this API.
# Development: use localhost ports.
# Production: set to your deployed frontend URL, e.g. https://agric-stat.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Forecasting ───────────────────────────────────────────────────────────────
FORECAST_DAYS=30
FORECAST_MODEL=prophet
