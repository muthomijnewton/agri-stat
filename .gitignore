# =============================================================================
# AgricStat Dash — root .gitignore
# =============================================================================

# ── Secrets & environment files ───────────────────────────────────────────────
.env
.env.local
.env.*.local
# Allow example / template files
!.env.example
!**/.env.example

# ── SQLite databases ──────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
.env/

# Pip installed directly into backend/ (not in a venv subfolder)
backend/Lib/
backend/Scripts/

# pytest / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
nosetests.xml
pytest.ini.bak

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Logs
*.log
server.log
server.err.log
install.log
install-debug.log

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
.cache/
.parcel-cache/
.next/
.nuxt/
.output/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Flutter / Dart ────────────────────────────────────────────────────────────
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.pub-cache/
mobile/.pub/
mobile/build/
mobile/**/*.g.dart
mobile/**/*.freezed.dart

# ── Editors & OS ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini
